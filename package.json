{
  "name": "bioartist",
  "private": true,
  "version": "0.1.0",
  "description": "BioArtist — scientific figure editor",
  "author": "BioArtist",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "ELECTRON=1 tsc -b && ELECTRON=1 vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mcp:install": "npm install --prefix mcp-server",
    "mcp:start": "npm start --prefix mcp-server",
    "packs:bioicons": "node scripts/build-bioicons-manifest.mjs",
    "electron:dev": "npm run build:electron && electron .",
    "electron:pack:mac": "npm run build:electron && electron-builder --mac --arm64 --x64 --config electron-builder.mac.yml",
    "electron:pack:mac:arm": "npm run build:electron && electron-builder --mac --arm64 --config electron-builder.mac.yml",
    "electron:pack:win": "npm run build:electron && electron-builder --win --x64 --config electron-builder.win.yml",
    "electron:pack:all": "npm run build:electron && electron-builder --mac --arm64 --x64 --config electron-builder.mac.yml && electron-builder --win --x64 --config electron-builder.win.yml"
  },
  "dependencies": {
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "3dmol": "^2.5.5",
    "fabric": "^7.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "ketcher-react": "^3.17.1",
    "ketcher-standalone": "^3.17.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
